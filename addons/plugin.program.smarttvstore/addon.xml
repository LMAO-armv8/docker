<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.program.smarttvstore"
       name="Smart TV App Store"
       version="1.0.0"
       provider-name="smarttv-retro">
  <requires>
    <import addon="xbmc.python" version="2.25.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Install curated Kodi Leia add-ons</summary>
    <description lang="en_GB">Browse and install pinned Leia-compatible add-ons for Smart TV Retro Pi 1.</description>
    <platform>all</platform>
    <language>en</language>
  </extension>
</addon>
